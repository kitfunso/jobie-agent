# Copy to .env and fill in. .env is git-ignored; never commit it.

# Default path: Amazon Bedrock via a Bedrock API key (console > Bedrock > API keys)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Bring-your-own-key path (optional, pick one and select it in the extension)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
